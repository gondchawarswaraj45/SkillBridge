# ==========================================
# SkillBridge Environment Configuration
# ==========================================

# ------------------------------------------
# Backend (Spring Boot) Configuration
# ------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database (Local or Aiven Cloud MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skillbridge
DB_USER=root
DB_PASSWORD=your_password
DB_SSL_MODE=PREFERRED

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI Provider Configuration
AI_PROVIDER=gemini # options: gemini, groq
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Mail Service (SMTP for verification / notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Payment Gateway (Cashfree / Razorpay)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=TEST # TEST or PROD

# ------------------------------------------
# Frontend Web (React + Vite) Configuration
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_BASE_URL=ws://localhost:8080/ws
VITE_APP_NAME=SkillBridge

# ------------------------------------------
# Frontend Mobile (Expo / React Native) Configuration
# ------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:8080/ws
EXPO_PUBLIC_APP_NAME=SkillBridge

